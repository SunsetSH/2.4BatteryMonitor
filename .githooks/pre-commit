#!/bin/sh
# Rejects AI agent files, secret files and key-like strings, and badly formatted C++ changes.
# Enable once per clone: git config core.hooksPath .githooks
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACMR)

forbidden=$(printf '%s\n' "$staged" | grep -E -i \
    '(^|/)(CLAUDE\.md|CLAUDE\.local\.md|AGENTS\.md|GEMINI\.md|\.cursorrules|\.windsurfrules|\.mcp\.json)$|(^|/)\.(claude|cursor|codex)/|(^|/)\.aider|(^|/)\.github/copilot-instructions\.md$|(^|/)\.env[^/]*$|\.(pem|key|p12|pfx|jks|keystore)$' \
    | grep -v -E '(^|/)\.env\.example$')
if [ -n "$forbidden" ]; then
    echo "pre-commit: these files must not be committed (AI agent files or secrets):" >&2
    printf '  %s\n' $forbidden >&2
    fail=1
fi

# Added lines only; the hooks themselves contain the patterns and are skipped.
secrets=$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude).githooks/*' \
    | grep -E '^\+[^+]' \
    | grep -E -i 'PRIVATE KEY|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|(password|passwd|client_?secret|secret_?key|api_?key|access_?token|auth_?token)[[:space:]]*[=:][[:space:]]*["'\'']?[A-Za-z0-9_/+.-]{8,}')
if [ -n "$secrets" ]; then
    echo "pre-commit: staged lines look like keys or passwords:" >&2
    printf '%s\n' "$secrets" | cut -c1-120 >&2
    fail=1
fi

# Formatting of changed C++ lines only (whole files keep their hand-aligned tables).
cpp=$(printf '%s\n' "$staged" | grep -E '\.(cpp|h)$')
# The initial import has no HEAD: every line would count as changed, so formatting starts with the second commit.
git rev-parse --verify -q HEAD >/dev/null || cpp=
if [ -n "$cpp" ]; then
    for dir in /c/msys64/mingw64/bin /mingw64/bin; do
        [ -x "$dir/clang-format" ] || [ -x "$dir/clang-format.exe" ] && PATH="$dir:$PATH"
    done
    gcf=$(command -v git-clang-format)
    py=$(command -v python3 || command -v python)
    if [ -n "$gcf" ] && [ -n "$py" ] && command -v clang-format >/dev/null; then
        # stderr carries unrelated git warnings (CRLF), so only a real diff on stdout fails the commit.
        diff=$("$py" "$gcf" --staged --diff -- $cpp 2>/dev/null)
        if printf '%s\n' "$diff" | grep -q '^diff --git'; then
            echo "pre-commit: clang-format changes needed in staged C++ lines:" >&2
            printf '%s\n' "$diff" | head -40 >&2
            echo "Fix: git clang-format --staged, then git add the files again." >&2
            fail=1
        fi
    else
        echo "pre-commit: clang-format or git-clang-format not found, formatting not checked." >&2
    fi
fi

exit $fail
